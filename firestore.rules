rules_version = '2';
// users/{uid}: username (3–20 ASCII letters/digits/_), usernameKey (lowercase),
// createdAt (server timestamp). All fields immutable. Private to this uid.
// usernames/{usernameKey}: uid (immutable, 1–128 chars). Exact authenticated
// lookup only. publicProfiles/{uid}: username, usernameKey (from users/{uid}),
// records (exact six keys, null or integer 0..1e9, only increases), updatedAt.
// Optional trainProgress: unlocked 1..8, completed 0..8; monotonic.
// leaderboards/{versionedBoard}/entries/{uid}: username, score, updatedAt.
// Public game records are client-reported, not verified competitive rankings.
// friendships/{length:a + a + length:b + b}: sorted members [a,b], from, to,
// status (pending/accepted), createdAt, updatedAt. Participants are immutable.
// All reads require Auth; friendship reads require membership.
// users/{uid}/saves/progress: private save envelope, version=1, payload string
// (JSON, 1..150000 chars), updatedAt server timestamp. Payload is opaque private
// game data, normalized by the client; it carries no authorization fields.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'usernameKey', 'createdAt'])
        && data.keys().hasOnly(['username', 'usernameKey', 'createdAt'])
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 20
        && data.username.matches('^[a-zA-Z0-9_]{3,20}$')
        && data.usernameKey is string && data.usernameKey.size() >= 3 && data.usernameKey.size() <= 20
        && data.usernameKey == data.username.lower()
        && data.createdAt is timestamp;
    }
    function isValidReservation(data) {
      return data.keys().hasAll(['uid']) && data.keys().hasOnly(['uid'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.uid == request.auth.uid;
    }
    function validScore(value) { return value == null || (value is int && value >= 0 && value <= 1000000000); }
    function grows(old, next) { return old == null || (next != null && next >= old); }
    function validRecords(r) {
      return r is map && r.keys().hasAll(['mirrorSurvival', 'mirrorChallenge', 'train', 'mathSmall', 'mathLarge', 'mathFinance'])
        && r.keys().hasOnly(['mirrorSurvival', 'mirrorChallenge', 'train', 'mathSmall', 'mathLarge', 'mathFinance'])
        && validScore(r.mirrorSurvival) && validScore(r.mirrorChallenge) && validScore(r.train)
        && validScore(r.mathSmall) && validScore(r.mathLarge) && validScore(r.mathFinance);
    }
    function validPublicProfile(data, uid) {
      let player = get(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasAll(['username', 'usernameKey', 'records', 'updatedAt'])
        && data.keys().hasOnly(['username', 'usernameKey', 'records', 'updatedAt', 'trainProgress'])
        && data.username == player.username && data.usernameKey == player.usernameKey
        && validRecords(data.records) && data.updatedAt == request.time
        && (!('trainProgress' in data) || validTrainProgress(data.trainProgress));
    }
    function validTrainProgress(p) {
      return p is map && p.keys().hasAll(['unlocked', 'completed']) && p.keys().hasOnly(['unlocked', 'completed'])
        && p.unlocked is int && p.unlocked >= 1 && p.unlocked <= 8
        && p.completed is int && p.completed >= 0 && p.completed <= p.unlocked
        && (p.completed < p.unlocked || p.completed == 8);
    }
    function trainProgressIncreases(a, b) {
      return !('trainProgress' in a) || ('trainProgress' in b
        && b.trainProgress.unlocked >= a.trainProgress.unlocked
        && b.trainProgress.completed >= a.trainProgress.completed);
    }
    function validBoard(board) {
      return board in ['math-small-v1', 'math-large-v1', 'math-finance-v1', 'mirror-survival-v2']
        || board.matches('^mirror-challenge-v2-l([1-9]|1[0-7])$')
        || board.matches('^train-v1-l[1-8]$');
    }
    function validEntry(data, uid) {
      return data.keys().hasAll(['username', 'score', 'updatedAt']) && data.keys().hasOnly(['username', 'score', 'updatedAt'])
        && data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && data.score is int && data.score >= 0 && data.score <= 1000000000
        && data.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(uid));
    }
    function recordsIncrease(a, b) {
      return grows(a.mirrorSurvival, b.mirrorSurvival) && grows(a.mirrorChallenge, b.mirrorChallenge)
        && grows(a.train, b.train) && grows(a.mathSmall, b.mathSmall)
        && grows(a.mathLarge, b.mathLarge) && grows(a.mathFinance, b.mathFinance);
    }
    function validUid(uid) { return uid is string && uid.size() >= 1 && uid.size() <= 128 && !uid.matches('.*[/].*'); }
    function validProgressSave(data) {
      return data.keys().hasAll(['version', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['version', 'payload', 'updatedAt'])
        && data.version is int && data.version == 1
        && data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 150000
        && data.updatedAt == request.time;
    }
    function validFriendship(data, id) {
      let m = data.members;
      return data.keys().hasAll(['members', 'from', 'to', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['members', 'from', 'to', 'status', 'createdAt', 'updatedAt'])
        && m is list && m.size() == 2 && validUid(m[0]) && validUid(m[1]) && m[0] < m[1]
        && id == string(m[0].size()) + ':' + m[0] + string(m[1].size()) + ':' + m[1]
        && data.from in m && data.to in m && data.from != data.to
        && data.status in ['pending', 'accepted'] && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if isOwner(uid) && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      // No profile editing is exposed in this version. Deny update/delete explicitly.
      allow update, delete: if false;
    }
    match /users/{uid}/saves/{save} {
      allow get: if isOwner(uid) && save == 'progress';
      allow list, delete: if false;
      allow create, update: if isOwner(uid) && save == 'progress'
        && exists(/databases/$(database)/documents/users/$(uid))
        && validProgressSave(request.resource.data);
    }
    match /usernames/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && key.matches('^[a-z0-9_]{3,20}$')
        && isValidReservation(request.resource.data)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == key;
      allow update, delete: if false;
    }
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create: if isOwner(uid) && validPublicProfile(request.resource.data, uid);
      allow update: if isOwner(uid) && validPublicProfile(request.resource.data, uid)
        && recordsIncrease(resource.data.records, request.resource.data.records)
        && trainProgressIncreases(resource.data, request.resource.data);
      allow delete: if false;
    }
    match /leaderboards/{board}/entries/{uid} {
      // Aggregations use the same read rule as queries. Only pseudonym and score are exposed.
      allow read: if signedIn() && validBoard(board);
      allow create: if isOwner(uid) && validBoard(board) && validEntry(request.resource.data, uid);
      allow update: if isOwner(uid) && validBoard(board) && validEntry(request.resource.data, uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
    match /friendships/{id} {
      // Transactions must be able to check a pair that does not yet exist.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/friendships/$(id)) || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validFriendship(request.resource.data, id)
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.from))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to));
      allow update: if signedIn() && validFriendship(request.resource.data, id)
        && request.auth.uid == resource.data.to && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
