# Configuration Web publique obtenue par npm run firebase:setup.
# Les mots de passe et clés Admin ne doivent jamais être placés dans VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=brain2jeu.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brain2jeu
VITE_FIREBASE_APP_ID=
# À adapter si la base sélectionnée porte un autre identifiant.
VITE_FIREBASE_DATABASE_ID=(default)
# Seulement pour le développement local, jamais activé dans le build de production.
VITE_USE_FIREBASE_EMULATORS=false
